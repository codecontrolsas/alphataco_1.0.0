# Postgres / almacenamiento S3 (RustFS) (compose)
POSTGRES_PASSWORD=cambiar
# Puertos de host. Si alguno esta ocupado en tu maquina, cambialo aca (nunca en
# docker-compose.yml). Ver docs/desarrollo/entornos.md.
POSTGRES_PORT=5432
S3_ACCESS_KEY=alphataco
S3_SECRET_KEY=cambiar-cambiar
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# El almacenamiento (RustFS) NO se publica en internet: el navegador nunca le habla. La app
# lo alcanza por la red del compose (el servicio `app` fija S3_ENDPOINT=http://storage:9000)
# y sirve los archivos por /api/files. Para correr `npm run dev` fuera de Docker, apuntar
# S3_ENDPOINT al puerto publicado de abajo (STORAGE_PORT).
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
# App
APP_PORT=3000
APP_DOMAIN=localhost
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Token con el que el contenedor `cron` autentica contra /api/jobs/* (Bearer). Generar con
# `openssl rand -hex 32`. Vacio = los tres endpoints rechazan TODO con 401 y los jobs no
# corren (es el default seguro: sin token no se abren).
JOBS_TOKEN=cambiar
# Token Bearer de solo lectura para GET /api/admin/v1/status (sala de control de TaskApp). Distinto de
# JOBS_TOKEN; generar con `openssl rand -base64 32`. Vacio = el endpoint rechaza todo con 401.
ADMIN_STATUS_TOKEN=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_PROJECT_URL=http://localhost:3000
NEXT_PUBLIC_SHOW_LOGS=false
# Auth (Better Auth)
# BETTER_AUTH_SECRET firma las cookies de sesion: generar con `openssl rand -base64 32`.
# Cambiarla invalida todas las sesiones abiertas.
BETTER_AUTH_SECRET=cambiar-cambiar-cambiar
# Login con Google (opcional): si estan vacias, el boton de Google no se muestra.
# Redirect URI a registrar en Google Cloud: <NEXT_PUBLIC_BASE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# SMTP — unico emisor del sistema (src/shared/lib/mail/transport.ts): invitacion de usuario,
# recuperacion de contrasena y los correos de los jobs de P5. Vacio = los mails NO se envian
# y el contenido se loguea; el cron sigue corriendo igual y anota "no enviado" en jobs_runs.
# Para probar envios de verdad en local, levantar el servicio `mailpit` del compose
# (`--profile mail`) y apuntar SMTP_HOST=mailpit / SMTP_PORT=1025 / SMTP_SECURE=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=
# Nombre del remitente en los emails salientes. Lo lee fromAddress() en
# src/shared/lib/mail/transport.ts; vacio = se manda solo la direccion de SMTP_FROM/SMTP_USER.
EMAIL_FROM_NAME=alphataco
# Puertos del SMTP de prueba (servicio `mailpit`, perfil `mail`): SMTP y web/API.
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
# TaskApp
TASKAPP_BASE_URL=
TASKAPP_PROJECT_API_KEY=

# Facturación electrónica ARCA
# Clave maestra (AES-256-GCM) con la que se cifran la clave privada del certificado y los tickets
# de WSAA. 32 bytes en base64: `openssl rand -base64 32`. Va SOLO en el entorno (nunca en la
# base). Si se pierde no se pierden facturas, pero hay que generar un certificado nuevo.
FISCAL_SECRETS_KEY=
# `mock` = ARCA simulado (demos y desarrollo sin certificado): CAE ficticio y comprobantes
# marcados "simulado". Vacío = ARCA real.
ARCA_MODE=
# Solo con ARCA_MODE=mock: `reject` fuerza un rechazo y `timeout` un corte de comunicación.
ARCA_MOCK_SCENARIO=
# `true` SOLO en el despliegue de producción: sin esto nadie puede emitir con validez fiscal,
# aunque la empresa tenga el ambiente en producción.
ARCA_ALLOW_PRODUCTION=false

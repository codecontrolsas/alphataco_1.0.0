{
  "name": "alphataco",
  "version": "0.1.1",
  "private": true,
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "npx prettier --write .",
    "prepare": "husky",
    "check-types": "tsc --noEmit",
    "cypress": "cypress open",
    "cypress:headless": "cypress run --spec 'cypress/e2e/**/*.cy.ts'",
    "test:e2e": "cypress run --spec 'cypress/e2e/**/*.cy.ts'",
    "test:e2e:open": "cypress open",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "bash scripts/test-db.sh",
    "test:auth": "bash scripts/test-auth.sh",
    "test:jobs": "bash scripts/test-jobs.sh",
    "test:warehouses": "bash scripts/test-warehouses.sh",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:baseline": "node scripts/sql/build-baseline.ts",
    "db:seed": "node scripts/seed-company.ts",
    "db:reset": "docker compose --env-file .env.docker rm -sf postgres && docker volume rm -f alphataco_pgdata && docker compose --env-file .env.docker up -d --wait postgres",
    "demo:reset": "node scripts/demo/reset.ts",
    "manual:check": "node scripts/check-manual.ts"
  },

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # anon key (pública)
SUPABASE_SERVICE_ROLE_KEY=          # SOLO servidor, nunca NEXT_PUBLIC_

# === Base de datos (Prisma) ===
DATABASE_URL=
DIRECT_URL=
# Opcionales, para cuando DATABASE_URL pase al rol de aplicacion alphataco_app (ver docs/deploy/runbook.md):
# MIGRATE_DATABASE_URL = usuario duenio que corre `prisma migrate deploy`; SYSTEM_DATABASE_URL = rol alphataco_system (seed, scripts).
MIGRATE_DATABASE_URL=
SYSTEM_DATABASE_URL=

# === Storage (RustFS/S3) ===
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Endpoint del almacenamiento. Solo lo usa el SERVIDOR: el navegador nunca le habla, los
# archivos salen por /api/files. Dentro del compose es http://storage:9000; para `npm run dev`
# fuera de Docker, el puerto publicado (STORAGE_PORT de .env.docker).
S3_ENDPOINT=http://localhost:9000

# === App ===
NEXT_PUBLIC_PROJECT_URL=
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_SHOW_LOGS=false

# === PostHog (analytics/errores) ===
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# === Email (SMTP para /api/send y Auth/actions/sendEmail.ts) ===
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
EMAIL_FROM_NAME=

# === TaskApp (Centro de Ayuda — backend de tickets en apitaskapp.codecontrol.com.ar) ===
TASKAPP_BASE_URL=
TASKAPP_PROJECT_API_KEY=

# USUARIOS DE TESTING EN DEV
# user.test = admin@p4.test
# pass.test =  P4-verificacion-123

# Para probar ropa y taller
#
# user: ropa@p4.test | pass: P4-verificacion-123 | URL: /clothing/login
# user:  taller@p4.test | pass : P4-verificacion-123 | URL: /operator/login
#

# === Facturación electrónica ARCA
# Clave maestra (AES-256-GCM) con la que se cifran la clave privada del certificado y los tickets
# de WSAA. 32 bytes en base64: `openssl rand -base64 32`. Va SOLO en el entorno (nunca en la
# base). Si se pierde no se pierden facturas, pero hay que generar un certificado nuevo.
FISCAL_SECRETS_KEY=
# `mock` = ARCA simulado (demos y desarrollo sin certificado): CAE ficticio y comprobantes
# marcados "simulado". Vacío = ARCA real.
ARCA_MODE=
# Solo con ARCA_MODE=mock: `reject` fuerza un rechazo y `timeout` un corte de comunicación.
ARCA_MOCK_SCENARIO=
# `true` SOLO en el despliegue de producción: sin esto nadie puede emitir con validez fiscal,
# aunque la empresa tenga el ambiente en producción.
ARCA_ALLOW_PRODUCTION=false

# === Sala de control (TaskApp) ===
# Token Bearer de SOLO LECTURA para GET /api/admin/v1/status. Distinto de JOBS_TOKEN.
# Generar con `openssl rand -base64 32`. Vacío = el endpoint rechaza todo con 401.
ADMIN_STATUS_TOKEN=

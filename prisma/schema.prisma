/// Historial de precios de un item de contrato.
///
/// `is_current` marca la revision que produjo el `service_items.item_price` vigente. El indice
/// unico parcial de mas abajo hace que la BASE impida dos vigentes para el mismo item, en vez
/// de confiar en que el codigo no se equivoque. La escritura es una sola: la action que aplica
/// una revision actualiza `item_price` y marca `is_current` en la MISMA transaccion.
model service_item_price_revisions {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_item_id String              @db.Uuid
  price           Decimal             @db.Decimal(15, 4)
  previous_price  Decimal?            @db.Decimal(15, 4)
  is_current      Boolean             @default(false)
  valid_from      DateTime            @db.Date
  source          price_update_method
  change_reason   String?
  /// uuid del profile que la aplico. Sin FK a proposito: borrar un usuario no debe llevarse
  /// la auditoria de un precio.
  created_by      String?             @db.Uuid
  run_id          String?             @db.Uuid
  created_at      DateTime            @default(now()) @db.Timestamptz(6)
  service_items   service_items       @relation(fields: [service_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  run             price_update_runs?  @relation(fields: [run_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([service_item_id], map: "idx_price_revisions_service_item_id")
  @@index([run_id], map: "idx_price_revisions_run_id")
  @@schema("public")
}

/// Regla de actualizacion de precios.
///
/// `customer_service_id` nulo = la regla aplica a toda la empresa; con contrato = solo a ese.
/// Eso es el "adaptable a cada empresa y a cada contrato" del pedido.
///
/// `config` guarda los parametros propios de cada metodo (codigo de indice, coeficientes del
/// polinomio). Va en jsonb y no en columnas fijas porque las tres formas no se parecen entre si.
model price_update_rules {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id          String              @db.Uuid
  customer_service_id String?             @db.Uuid
  name                String
  method              price_update_method
  config              Json                @default("{}")
  is_active           Boolean             @default(true)
  created_by          String?             @db.Uuid
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  company             company             @relation(fields: [company_id], references: [id], onDelete: Cascade)
  customer_services   customer_services?  @relation(fields: [customer_service_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  runs                price_update_runs[]

  @@index([company_id], map: "idx_price_update_rules_company_id")
  @@index([customer_service_id], map: "idx_price_update_rules_customer_service_id")
  @@schema("public")
}

/// Ejecucion de una regla de actualizacion. Cada revision de precio apunta a su corrida, asi
/// un precio siempre puede explicar de donde salio. `rule_id` nulo = ajuste manual suelto.
model price_update_runs {
  id              String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id      String                         @db.Uuid
  rule_id         String?                        @db.Uuid
  applied_at      DateTime                       @default(now()) @db.Timestamptz(6)
  applied_by      String?                        @db.Uuid
  items_affected  Int                            @default(0)
  note            String?
  company         company                        @relation(fields: [company_id], references: [id], onDelete: Cascade)
  rule            price_update_rules?            @relation(fields: [rule_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  price_revisions service_item_price_revisions[]

  @@index([company_id], map: "idx_price_update_runs_company_id")
  @@index([rule_id], map: "idx_price_update_runs_rule_id")
  @@schema("public")
}

/// Certificacion: lo trabajado para un cliente, bajo un contrato, en un periodo.
///
/// En `borrador` las lineas se recalculan contra el precio vigente. Al pasar a `emitida` el
/// precio unitario se COPIA a cada linea y el documento deja de mirar el catalogo: reimprimirla
/// devuelve siempre los mismos importes. Una emitida no se muta; si hay que corregirla se anula
/// y se emite otra.
model certifications {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id          String                @db.Uuid
  customer_id         String                @db.Uuid
  customer_service_id String                @db.Uuid
  number              String
  period_from         DateTime              @db.Date
  period_to           DateTime              @db.Date
  status              certification_status  @default(borrador)
  /// Copiada del contrato al crear, para que la certificacion no cambie de moneda si el
  /// contrato se edita despues.
  currency            String                @db.Char(3)
  total               Decimal               @default(0) @db.Decimal(15, 2)
  notes               String?
  issued_at           DateTime?             @db.Timestamptz(6)
  issued_by           String?               @db.Uuid
  confirmed_at        DateTime?             @db.Timestamptz(6)
  confirmed_by        String?               @db.Uuid
  voided_at           DateTime?             @db.Timestamptz(6)
  voided_by           String?               @db.Uuid
  voided_reason       String?
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  company             company               @relation(fields: [company_id], references: [id], onDelete: Cascade)
  customers           customers             @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customer_services   customer_services     @relation(fields: [customer_service_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lines               certification_lines[]
  invoice_certifications invoice_certifications[]
  invoice_lines          invoice_lines[]

  @@unique([company_id, number])
  @@index([company_id], map: "idx_certifications_company_id")
  @@index([customer_id], map: "idx_certifications_customer_id")
  @@index([customer_service_id], map: "idx_certifications_customer_service_id")
  @@index([status], map: "idx_certifications_status")
  @@schema("public")
}

/// Linea de certificacion. `unit_price` queda congelado al emitir; `amount` es el redondeo a
/// 2 decimales de cantidad x unitario, y el total de la cabecera es la suma de estos importes
/// ya redondeados, no el redondeo de una suma: asi el papel cierra cuando se verifica a mano.
model certification_lines {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  certification_id  String           @db.Uuid
  /// De que linea de parte diario sale. `SetNull` y no `Cascade`: borrar un parte no puede
  /// alterar los importes de una certificacion ya emitida.
  dailyreportrow_id String?          @db.Uuid
  service_item_id   String           @db.Uuid
  description       String
  quantity          Decimal          @db.Decimal(15, 4)
  unit_price        Decimal          @db.Decimal(15, 4)
  amount            Decimal          @db.Decimal(15, 2)
  /// `false` cuando la certificación se anula. Una línea de parte diario puede estar en UNA sola
  /// línea viva (índice único parcial): así el mismo trabajo no se certifica ni se factura dos
  /// veces. Lo mantiene el código (anular la certificación lo apaga), no un trigger.
  is_live           Boolean          @default(true)
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  certifications    certifications   @relation(fields: [certification_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  service_items     service_items    @relation(fields: [service_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dailyreportrows   dailyreportrows? @relation(fields: [dailyreportrow_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([dailyreportrow_id], map: "uq_certification_lines_live_row", where: raw("(is_live AND dailyreportrow_id IS NOT NULL)"))
  @@index([certification_id], map: "idx_certification_lines_certification_id")
  @@index([dailyreportrow_id], map: "idx_certification_lines_dailyreportrow_id")
  @@index([service_item_id], map: "idx_certification_lines_service_item_id")
  @@schema("public")
}

// ─── Facturación electrónica ARCA ───────────────────────────────────────────────

/// Ambiente de ARCA. Homologación y producción no comparten certificados ni numeración.
enum arca_environment {
  homologacion
  produccion

  @@schema("public")
}

/// Condición frente al IVA del EMISOR. Define la letra: RI emite A/B, monotributo y exento C.
/// La del receptor se guarda como el id de ARCA (RG 5616), no como enum.
enum fiscal_tax_condition {
  responsable_inscripto
  monotributo
  exento

  @@schema("public")
}

enum gross_income_regime {
  local
  convenio_multilateral
  exento

  @@schema("public")
}

enum arca_credential_status {
  /// Clave y CSR generados; falta cargar el certificado que devuelve ARCA.
  pendiente
  activo
  /// Reemplazado por una renovación. Se conserva como historial.
  reemplazado

  @@schema("public")
}

/// Datos fiscales del emisor (1:1 con la empresa). Razón social y CUIT salen de `company`.
model company_fiscal_profiles {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id             String                @unique @db.Uuid
  tax_condition          fiscal_tax_condition
  gross_income_number    String?               @db.VarChar(30)
  gross_income_regime    gross_income_regime?
  activity_start_date    DateTime              @db.Date
  fiscal_street          String                @db.VarChar(255)
  fiscal_city            String                @db.VarChar(120)
  fiscal_province_id     BigInt?
  fiscal_postal_code     String                @db.VarChar(10)
  /// Ambiente con el que se emite. Pasar a producción exige además `ARCA_ALLOW_PRODUCTION`.
  environment            arca_environment      @default(homologacion)
  environment_changed_at DateTime?             @db.Timestamptz(6)
  environment_changed_by String?               @db.Uuid
  created_at             DateTime              @default(now()) @db.Timestamptz(6)
  updated_at             DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  company                company               @relation(fields: [company_id], references: [id], onDelete: Cascade)
  provinces              provinces?            @relation(fields: [fiscal_province_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("public")
}

/// Punto de venta dado de alta en ARCA para "Factura electrónica - Web Services". Con
/// comprobantes no se borra: se desactiva.
model sales_points {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id String   @db.Uuid
  number     Int
  name       String   @db.VarChar(120)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  company    company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  invoices   invoices[]

  @@unique([company_id, number])
  @@schema("public")
}

/// Certificado de ARCA por empresa y ambiente. La clave privada se genera en el servidor y se
/// guarda cifrada (AES-256-GCM con `FISCAL_SECRETS_KEY`, formato `v<n>.<iv>.<tag>.<ct>`): nunca
/// se devuelve al cliente ni se loguea. A lo sumo un `activo` y un `pendiente` por ambiente.
model arca_credentials {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id       String                 @db.Uuid
  environment      arca_environment
  status           arca_credential_status
  alias            String                 @db.VarChar(60)
  private_key_enc  String
  csr_pem          String
  certificate_pem  String?
  cert_subject     String?
  cert_issuer      String?
  cert_serial      String?                @db.VarChar(64)
  cert_not_before  DateTime?              @db.Timestamptz(6)
  cert_not_after   DateTime?              @db.Timestamptz(6)
  /// Resultado de la última "Probar conexión" (lista de chequeos), para mostrarlo al volver.
  last_test_at     DateTime?              @db.Timestamptz(6)
  last_test_ok     Boolean?
  last_test_result Json?
  created_by       String?                @db.Uuid
  activated_at     DateTime?              @db.Timestamptz(6)
  created_at       DateTime               @default(now()) @db.Timestamptz(6)
  updated_at       DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  company          company                @relation(fields: [company_id], references: [id], onDelete: Cascade)
  arca_tokens      arca_tokens[]

  @@unique([company_id, environment], map: "uq_arca_credentials_active", where: raw("(status = 'activo'::arca_credential_status)"))
  @@unique([company_id, environment], map: "uq_arca_credentials_pending", where: raw("(status = 'pendiente'::arca_credential_status)"))
  @@index([company_id, environment], map: "idx_arca_credentials_company_env")
  @@schema("public")
}

/// Ticket de acceso de WSAA (~12 h) cifrado. ARCA no entrega otro mientras éste esté vigente,
/// así que se persiste ANTES de usarlo y se reutiliza. Va atado a la credencial que lo firmó.
model arca_tokens {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id    String           @db.Uuid
  environment   arca_environment
  service       String           @default("wsfe") @db.VarChar(20)
  credential_id String           @db.Uuid
  token_enc     String
  sign_enc      String
  expires_at    DateTime         @db.Timestamptz(6)
  updated_at    DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  company       company          @relation(fields: [company_id], references: [id], onDelete: Cascade)
  credential    arca_credentials @relation(fields: [credential_id], references: [id], onDelete: Cascade)

  @@unique([company_id, environment, service])
  @@schema("public")
}

/// Exclusión mutua entre procesos (lease con vencimiento): pedido de ticket WSAA y numeración de
/// comprobantes. No es un lock de transacción porque abarca llamadas a ARCA, que nunca van
/// dentro de una transacción. Si el proceso muere, el lease vence solo.
model arca_locks {
  key          String   @id
  owner        String
  locked_until DateTime @db.Timestamptz(6)

  @@schema("public")
}

/// Bitácora de llamadas a ARCA (auditoría y diagnóstico). Token, sign y CMS se redactan antes
/// de guardar.
model arca_call_logs {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id   String           @db.Uuid
  environment  arca_environment
  operation    String           @db.VarChar(60)
  invoice_id   String?          @db.Uuid
  http_status  Int?
  duration_ms  Int
  error        String?
  request_xml  String
  response_xml String?
  created_at   DateTime         @default(now()) @db.Timestamptz(6)
  company      company          @relation(fields: [company_id], references: [id], onDelete: Cascade)
  invoice      invoices?        @relation(fields: [invoice_id], references: [id], onDelete: SetNull)

  @@index([company_id, created_at], map: "idx_arca_call_logs_company_created")
  @@index([invoice_id], map: "idx_arca_call_logs_invoice", where: raw("(invoice_id IS NOT NULL)"))
  @@schema("public")
}

/// Ciclo de vida de un comprobante.
///
/// borrador ──emitir──> emitiendo ──A──> autorizada (final: solo una NC la contrarresta)
///                         ├──R──> rechazada (editable como un borrador)
///                         └──sin respuesta──> pendiente ──consultar en ARCA──> autorizada | borrador
enum invoice_status {
  borrador
  emitiendo
  pendiente
  rechazada
  autorizada

  @@schema("public")
}

/// Comprobante electrónico: factura, nota de crédito o nota de débito (A, B o C). La clase y la
/// letra salen de `cbte_type` (id de ARCA, ver src/shared/lib/arca/catalogs.ts). Una vez
/// autorizada es inmutable (trigger `invoices_guard_immutable`).
///
/// `number` se asigna al emitir (último autorizado + 1) y se guarda ANTES de pedir el CAE: si
/// ARCA no responde, es lo que permite reconciliar con `FECompConsultar` sin duplicar.
model invoices {
  id                        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id                String                   @db.Uuid
  /// Ambiente con el que se emitió (o se va a emitir). La numeración es por ambiente.
  environment               arca_environment
  status                    invoice_status           @default(borrador)
  /// Emitido con ARCA simulado (`ARCA_MODE=mock`, demos): el CAE es ficticio y no tiene validez.
  simulated                 Boolean                  @default(false)
  sales_point_id            String                   @db.Uuid
  customer_id               String                   @db.Uuid
  cbte_type                 Int
  number                    Int?
  /// 1 productos, 2 servicios, 3 ambos.
  concept                   Int                      @default(2)
  issue_date                DateTime                 @db.Date
  service_from              DateTime?                @db.Date
  service_to                DateTime?                @db.Date
  payment_due_date          DateTime?                @db.Date
  /// ISO (como contratos y certificaciones) y el código de ARCA (`PES`, `DOL`, `060`).
  currency                  String                   @db.Char(3)
  arca_currency_id          String                   @db.VarChar(3)
  /// Cotización de ARCA congelada al emitir (1 en pesos).
  exchange_rate             Decimal                  @default(1) @db.Decimal(18, 6)
  exchange_rate_date        DateTime?                @db.Date
  net_taxed                 Decimal                  @default(0) @db.Decimal(15, 2)
  net_untaxed               Decimal                  @default(0) @db.Decimal(15, 2)
  exempt_amount             Decimal                  @default(0) @db.Decimal(15, 2)
  vat_total                 Decimal                  @default(0) @db.Decimal(15, 2)
  other_taxes               Decimal                  @default(0) @db.Decimal(15, 2)
  total                     Decimal                  @default(0) @db.Decimal(15, 2)
  receiver_doc_type         Int                      @default(80)
  receiver_doc_number       BigInt
  receiver_vat_condition_id Int
  /// Copia de los datos de emisor y receptor al emitir: el PDF se puede regenerar igual aunque
  /// cambien después.
  issuer_snapshot           Json?
  receiver_snapshot         Json?
  /// NC/ND: el comprobante que ajusta (`CbtesAsoc`).
  associated_invoice_id     String?                  @db.Uuid
  cae                       String?                  @db.VarChar(14)
  cae_due_date              DateTime?                @db.Date
  authorized_at             DateTime?                @db.Timestamptz(6)
  arca_result               String?                  @db.Char(1)
  arca_observations         Json?
  arca_errors               Json?
  /// Intención: el pedido exacto que se mandó (o se va a mandar) a ARCA.
  request_payload           Json?
  claimed_at                DateTime?                @db.Timestamptz(6)
  sent_at                   DateTime?                @db.Timestamptz(6)
  attempt_count             Int                      @default(0)
  needs_review              Boolean                  @default(false)
  review_note               String?
  pdf_path                  String?
  pdf_generated_at          DateTime?                @db.Timestamptz(6)
  notes                     String?
  created_by                String?                  @db.Uuid
  emitted_by                String?                  @db.Uuid
  created_at                DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)
  company                   company                  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  sales_point               sales_points             @relation(fields: [sales_point_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  customer                  customers                @relation(fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  associated_invoice        invoices?                @relation("InvoiceAdjustments", fields: [associated_invoice_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  adjustments               invoices[]               @relation("InvoiceAdjustments")
  lines                     invoice_lines[]
  vat_breakdown             invoice_vat[]
  certifications            invoice_certifications[]
  arca_call_logs            arca_call_logs[]

  @@unique([sales_point_id, environment, cbte_type, number], map: "uq_invoices_number")
  @@index([company_id, status], map: "idx_invoices_company_status")
  @@index([company_id, issue_date(sort: Desc)], map: "idx_invoices_company_issue_date")
  @@index([customer_id], map: "idx_invoices_customer")
  @@index([associated_invoice_id], map: "idx_invoices_associated", where: raw("(associated_invoice_id IS NOT NULL)"))
  @@schema("public")
}

/// Línea del comprobante. `net_amount` es la fuente de verdad (no se recalcula como cantidad x
/// unitario): una línea que agrupa líneas de certificación suma sus importes ya redondeados, que
/// es lo que el cliente aprobó. `vat_rate_id` nulo = comprobante C (no discrimina IVA).
model invoice_lines {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoice_id       String          @db.Uuid
  position         Int
  description      String
  quantity         Decimal         @db.Decimal(15, 4)
  unit_price       Decimal         @db.Decimal(15, 4)
  net_amount       Decimal         @db.Decimal(15, 2)
  vat_rate_id      Int?
  service_item_id  String?         @db.Uuid
  certification_id String?         @db.Uuid
  invoice          invoices        @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  service_item     service_items?  @relation(fields: [service_item_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  certification    certifications? @relation(fields: [certification_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([invoice_id, position])
  @@schema("public")
}

/// Subtotal por alícuota (array `Iva` de ARCA). El IVA se redondea UNA vez por alícuota, no por
/// línea: es lo que valida ARCA.
model invoice_vat {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoice_id  String   @db.Uuid
  vat_rate_id Int
  base_amount Decimal  @db.Decimal(15, 2)
  vat_amount  Decimal  @db.Decimal(15, 2)
  invoice     invoices @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@unique([invoice_id, vat_rate_id])
  @@schema("public")
}

/// Certificaciones que factura un comprobante. Un borrador ya las reserva. En PRODUCCIÓN una
/// certificación se factura una sola vez (índice único parcial); en homologación no se consumen,
/// así las pruebas no tocan el circuito real. Una NC total las libera (`released_at`).
model invoice_certifications {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoice_id       String           @db.Uuid
  certification_id String           @db.Uuid
  environment      arca_environment
  amount           Decimal          @db.Decimal(15, 2)
  released_at      DateTime?        @db.Timestamptz(6)
  invoice          invoices         @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  certification    certifications   @relation(fields: [certification_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([invoice_id, certification_id])
  @@unique([certification_id], map: "uq_invoice_certifications_live_prod", where: raw("((environment = 'produccion'::arca_environment) AND (released_at IS NULL))"))
  @@index([certification_id], map: "idx_invoice_certifications_certification")
  @@schema("public")
}

// ── Almacenes (etapa 1) ─────────────────────────────────────────────────────
// Spec: docs/superpowers/specs/2026-10-04-almacenes-etapa-1-design.md
//
// Lo que Prisma no modela y vive SOLO en la migracion 20261004100000_warehouses_core:
// los CHECK de cantidades/destinos/transferencias, el unico de `stock_balances` con
// NULLS NOT DISTINCT (un saldo por material+deposito+lote, con lote NULL incluido).
//
// `stock_balances`, `material_units`, `material_batches` (alta) y `materials.average_cost`
// los escribe UNICAMENTE el motor de stock (src/features/Warehouses/lib/stock-engine.ts).

enum material_tracking_type {
  QUANTITY
  SERIAL
  BATCH

  @@schema("public")
}

enum material_unit_status {
  IN_STOCK
  OUT
  DISCARDED

  @@schema("public")
}

enum stock_movement_type {
  ENTRY
  EXIT
  TRANSFER
  ADJUSTMENT
  /// Devolucion de unidades serializadas prestadas (etapa 2). Solo la registra `registerReturn`.
  RETURN

  @@schema("public")
}

enum material_request_status {
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_DELIVERED
  DELIVERED
  REJECTED
  CLOSED
  CANCELLED

  @@schema("public")
}

enum material_write_off_reason {
  LOST
  BROKEN

  @@schema("public")
}

enum stock_destination_type {
  EMPLOYEE
  VEHICLE
  OTHER_EQUIPMENT
  MAINTENANCE_ORDER
  CUSTOMER

  @@schema("public")
}

model warehouses {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id          String            @db.Uuid
  code                String
  name                String
  address             String?
  manager_employee_id String?           @db.Uuid
  is_active           Boolean           @default(true)
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  updated_at          DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  company             company           @relation(fields: [company_id], references: [id], onDelete: Cascade)
  manager             employees?        @relation("warehouse_manager", fields: [manager_employee_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  stock_balances      stock_balances[]
  material_units      material_units[]
  movements           stock_movements[] @relation("movement_warehouse")
  incoming_transfers  stock_movements[] @relation("movement_target_warehouse")
  clothing_deliveries clothing_deliveries[]

  @@unique([company_id, code])
  @@unique([company_id, name])
  @@index([company_id], map: "idx_warehouses_company_id")
  @@schema("public")
}

model material_categories {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id String      @db.Uuid
  name       String
  is_active  Boolean     @default(true)
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  updated_at DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  company    company     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  materials  materials[]

  @@unique([company_id, name])
  @@schema("public")
}

model measurement_units {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id   String      @db.Uuid
  name         String
  abbreviation String
  is_active    Boolean     @default(true)
  created_at   DateTime    @default(now()) @db.Timestamptz(6)
  updated_at   DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  company      company     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  materials    materials[]

  @@unique([company_id, name])
  @@unique([company_id, abbreviation])
  @@schema("public")
}

model materials {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id        String                 @db.Uuid
  code              String
  name              String
  description       String?
  category_id       String?                @db.Uuid
  unit_id           String                 @db.Uuid
  /// No editable una vez que el material tiene movimientos.
  tracking_type     material_tracking_type @default(QUANTITY)
  /// Se usa en la etapa 3 (pedidos con aprobacion).
  requires_approval Boolean                @default(false)
  /// Minimo a nivel empresa (suma de todos los depositos).
  min_stock         Decimal?               @db.Decimal(15, 4)
  /// Costo promedio ponderado de la empresa. Solo lo escribe el motor de stock.
  average_cost      Decimal                @default(0) @db.Decimal(15, 4)
  is_active         Boolean                @default(true)
  created_at        DateTime               @default(now()) @db.Timestamptz(6)
  updated_at        DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  company           company                @relation(fields: [company_id], references: [id], onDelete: Cascade)
  category          material_categories?   @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  unit              measurement_units      @relation(fields: [unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  batches           material_batches[]
  units             material_units[]
  stock_balances    stock_balances[]
  movement_lines    stock_movement_lines[]
  request_lines     material_request_lines[]
  clothing_combination clothing_item_materials?
  tire_combination     tire_materials?

  @@unique([company_id, code])
  @@index([company_id], map: "idx_materials_company_id")
  @@index([category_id], map: "idx_materials_category_id")
  @@schema("public")
}

model material_batches {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id     String                 @db.Uuid
  material_id    String                 @db.Uuid
  batch_number   String
  expires_at     DateTime?              @db.Date
  created_at     DateTime               @default(now()) @db.Timestamptz(6)
  company        company                @relation(fields: [company_id], references: [id], onDelete: Cascade)
  material       materials              @relation(fields: [material_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stock_balances stock_balances[]
  movement_lines stock_movement_lines[]

  @@unique([material_id, batch_number])
  @@index([company_id, expires_at], map: "idx_material_batches_company_expires")
  @@schema("public")
}

model material_units {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id       String                 @db.Uuid
  material_id      String                 @db.Uuid
  serial_number    String
  status           material_unit_status   @default(IN_STOCK)
  /// Lleno solo mientras la unidad esta IN_STOCK (CHECK en la migracion).
  warehouse_id     String?                @db.Uuid
  /// Ultimo movimiento: dice donde esta o quien la tiene.
  last_movement_id String?                @db.Uuid
  created_at       DateTime               @default(now()) @db.Timestamptz(6)
  updated_at       DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  company          company                @relation(fields: [company_id], references: [id], onDelete: Cascade)
  material         materials              @relation(fields: [material_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  warehouse        warehouses?            @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  last_movement    stock_movements?       @relation("unit_last_movement", fields: [last_movement_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  movement_lines   stock_movement_lines[]
  write_offs       material_unit_write_offs[]
  tire             tires?

  @@unique([material_id, serial_number])
  @@index([warehouse_id], map: "idx_material_units_warehouse_id")
  @@schema("public")
}

/// Saldo materializado: una fila por material + deposito + lote (lote NULL para los que no
/// son BATCH). La unicidad real es un indice NULLS NOT DISTINCT escrito a mano en la migracion.
model stock_balances {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id   String            @db.Uuid
  material_id  String            @db.Uuid
  warehouse_id String            @db.Uuid
  batch_id     String?           @db.Uuid
  quantity     Decimal           @default(0) @db.Decimal(15, 4)
  updated_at   DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  company      company           @relation(fields: [company_id], references: [id], onDelete: Cascade)
  material     materials         @relation(fields: [material_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  warehouse    warehouses        @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  batch        material_batches? @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([company_id], map: "idx_stock_balances_company_id")
  @@index([material_id, warehouse_id], map: "idx_stock_balances_material_warehouse")
  @@index([warehouse_id], map: "idx_stock_balances_warehouse_id")
  @@schema("public")
}

/// Movimiento de stock. Inmutable: los errores se corrigen con una anulacion
/// (`reverses_movement_id`), nunca editando.
model stock_movements {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id           String                  @db.Uuid
  number               String
  type                 stock_movement_type
  warehouse_id         String                  @db.Uuid
  target_warehouse_id  String?                 @db.Uuid
  occurred_on          DateTime                @db.Date
  reference            String?
  notes                String?
  destination_type     stock_destination_type?
  employee_id          String?                 @db.Uuid
  vehicle_id           String?                 @db.Uuid
  other_equipment_id   String?                 @db.Uuid
  maintenance_order_id String?                 @db.Uuid
  customer_id          String?                 @db.Uuid
  customer_service_id  String?                 @db.Uuid
  reverses_movement_id String?                 @unique @db.Uuid
  /// Solo RETURN: la salida cuyo prestamo cierra la devolucion.
  returned_from_movement_id String?            @db.Uuid
  /// Solo EXIT: entrega de un pedido de materiales (etapa 3).
  material_request_id  String?                 @db.Uuid
  total_cost           Decimal                 @default(0) @db.Decimal(15, 4)
  created_by           String                  @db.Uuid
  created_at           DateTime                @default(now()) @db.Timestamptz(6)
  company              company                 @relation(fields: [company_id], references: [id], onDelete: Cascade)
  warehouse            warehouses              @relation("movement_warehouse", fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  target_warehouse     warehouses?             @relation("movement_target_warehouse", fields: [target_warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee             employees?              @relation("stock_movement_employee", fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicle              vehicles?               @relation(fields: [vehicle_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_equipment      other_equipment?        @relation(fields: [other_equipment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  maintenance_order    maintenance_orders?     @relation(fields: [maintenance_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer             customers?              @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer_service     customer_services?      @relation(fields: [customer_service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator              profile                 @relation("stock_movement_creator", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reverses             stock_movements?        @relation("stock_movement_reversal", fields: [reverses_movement_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversed_by          stock_movements?        @relation("stock_movement_reversal")
  returned_from        stock_movements?        @relation("stock_movement_return", fields: [returned_from_movement_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  returns              stock_movements[]       @relation("stock_movement_return")
  write_offs           material_unit_write_offs[]
  material_request     material_requests?      @relation(fields: [material_request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines                stock_movement_lines[]
  units_last_here      material_units[]        @relation("unit_last_movement")
  clothing_delivery    clothing_deliveries?
  tire_item_mounts     tire_service_items[]    @relation("tire_item_mount")
  tire_item_returns    tire_service_items[]    @relation("tire_item_return")

  @@unique([company_id, number])
  @@index([company_id, occurred_on, created_at], map: "idx_stock_movements_company_date")
  @@index([warehouse_id], map: "idx_stock_movements_warehouse_id")
  @@index([employee_id], map: "idx_stock_movements_employee_id")
  @@index([vehicle_id], map: "idx_stock_movements_vehicle_id")
  @@index([other_equipment_id], map: "idx_stock_movements_other_equipment_id")
  @@index([maintenance_order_id], map: "idx_stock_movements_maintenance_order_id")
  @@index([customer_id], map: "idx_stock_movements_customer_id")
  @@index([returned_from_movement_id], map: "idx_stock_movements_returned_from")
  @@index([material_request_id], map: "idx_stock_movements_material_request")
  @@schema("public")
}

model stock_movement_lines {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  movement_id String            @db.Uuid
  material_id String            @db.Uuid
  quantity    Decimal           @db.Decimal(15, 4)
  /// Efecto sobre el saldo de `warehouse_id` del movimiento: +1 entra, -1 sale.
  direction   Int               @db.SmallInt
  unit_cost   Decimal           @db.Decimal(15, 4)
  total_cost  Decimal           @db.Decimal(15, 4)
  batch_id    String?           @db.Uuid
  unit_id     String?           @db.Uuid
  /// Linea de pedido que satisface esta linea de entrega (etapa 3).
  request_line_id String?       @db.Uuid
  movement    stock_movements   @relation(fields: [movement_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  request_line material_request_lines? @relation(fields: [request_line_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  material    materials         @relation(fields: [material_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  batch       material_batches? @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit        material_units?   @relation(fields: [unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([movement_id], map: "idx_stock_movement_lines_movement_id")
  @@index([material_id], map: "idx_stock_movement_lines_material_id")
  @@index([request_line_id], map: "idx_stock_movement_lines_request_line")
  @@schema("public")
}

/// Baja de una unidad serializada que estaba prestada y no vuelve (extraviada o rota). No es un
/// movimiento de stock: la unidad ya habia salido y su costo queda imputado a quien la tenia.
model material_unit_write_offs {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id       String                    @db.Uuid
  unit_id          String                    @db.Uuid
  /// Ultimo movimiento de la unidad al darla de baja: el prestamo que cierra.
  loan_movement_id String                    @db.Uuid
  reason           material_write_off_reason
  notes            String
  created_by       String                    @db.Uuid
  created_at       DateTime                  @default(now()) @db.Timestamptz(6)
  company          company                   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  unit             material_units            @relation(fields: [unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loan_movement    stock_movements           @relation(fields: [loan_movement_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator          profile                   @relation("material_write_off_creator", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([unit_id, loan_movement_id])
  @@index([company_id], map: "idx_material_unit_write_offs_company_id")
  @@schema("public")
}

/// Pedido de materiales con aprobacion (etapa 3). Se entrega en una o varias salidas de stock
/// (`stock_movements.material_request_id`); lo entregado se calcula de esas salidas.
model material_requests {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id           String                  @db.Uuid
  number               String
  status               material_request_status @default(PENDING_APPROVAL)
  requested_by         String                  @db.Uuid
  destination_type     stock_destination_type
  employee_id          String?                 @db.Uuid
  vehicle_id           String?                 @db.Uuid
  other_equipment_id   String?                 @db.Uuid
  maintenance_order_id String?                 @db.Uuid
  customer_id          String?                 @db.Uuid
  customer_service_id  String?                 @db.Uuid
  /// OT desde la que se pidio (etapa 4). Solo con destino MAINTENANCE_ORDER (CHECK en BD).
  work_order_id        String?                 @db.Uuid
  notes                String?
  decided_by           String?                 @db.Uuid
  decided_at           DateTime?               @db.Timestamptz(6)
  decision_notes       String?
  closed_by            String?                 @db.Uuid
  closed_at            DateTime?               @db.Timestamptz(6)
  close_notes          String?
  created_at           DateTime                @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  company              company                 @relation(fields: [company_id], references: [id], onDelete: Cascade)
  requester            profile                 @relation("material_request_requester", fields: [requested_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  decider              profile?                @relation("material_request_decider", fields: [decided_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  closer               profile?                @relation("material_request_closer", fields: [closed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee             employees?              @relation("material_request_employee", fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicle              vehicles?               @relation(fields: [vehicle_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_equipment      other_equipment?        @relation(fields: [other_equipment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  maintenance_order    maintenance_orders?     @relation(fields: [maintenance_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer             customers?              @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer_service     customer_services?      @relation(fields: [customer_service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  work_order           work_orders?            @relation(fields: [work_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines                material_request_lines[]
  deliveries           stock_movements[]

  @@unique([company_id, number])
  @@index([company_id, status], map: "idx_material_requests_company_status")
  @@index([requested_by], map: "idx_material_requests_requested_by")
  @@index([work_order_id], map: "idx_material_requests_work_order")
  @@schema("public")
}

model material_request_lines {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id     String                 @db.Uuid
  material_id    String                 @db.Uuid
  quantity       Decimal                @db.Decimal(15, 4)
  request        material_requests      @relation(fields: [request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  material       materials              @relation(fields: [material_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  delivery_lines stock_movement_lines[]

  @@index([request_id], map: "idx_material_request_lines_request_id")
  @@schema("public")
}

/// Configuracion de Almacenes por empresa (etapa 3).
model warehouse_settings {
  company_id             String   @id @db.Uuid
  /// Monto maximo de una salida directa (sin pedido). NULL = sin limite.
  direct_exit_max_amount Decimal? @db.Decimal(15, 2)
  updated_at             DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  updated_by             String?  @db.Uuid
  company                company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@schema("public")
}

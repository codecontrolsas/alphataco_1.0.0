  // Datos de contacto (misma nullability que employees)
  street        String
  street_number String
  province      BigInt
  city          BigInt?
  postal_code   String?
  phone         String
  email         String?

  // Datos laborales propuestos (unicos dos campos laborales del pre legajo)

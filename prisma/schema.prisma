/// Credenciales de los sistemas externos que consultan la API de solo lectura
/// (ticket 671). El secreto NUNCA se guarda en claro: solo su hash scrypt.
model external_api_clients {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id    String    @db.Uuid
  name          String
  /// Identificador publico que viaja como usuario en el Basic Auth
  client_id     String    @unique
  /// Formato autodescriptivo scrypt$N$r$p$salt$hash
  secret_hash   String
  /// Primeros caracteres del secreto, solo para poder identificarlo en pantalla
  secret_prefix String
  is_active     Boolean   @default(true)
  revoked_at    DateTime? @db.Timestamptz(6)
  last_used_at  DateTime? @db.Timestamptz(6)
  notes         String?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  created_by    String?   @db.Uuid
  revoked_by    String?   @db.Uuid

  company     company                    @relation(fields: [company_id], references: [id], onDelete: Cascade)
  creator     profile?                   @relation("external_api_clients_created_byToprofile", fields: [created_by], references: [id], onDelete: SetNull)
  revoker     profile?                   @relation("external_api_clients_revoked_byToprofile", fields: [revoked_by], references: [id], onDelete: SetNull)
  access_logs external_api_access_logs[]

  @@index([company_id], map: "idx_external_api_clients_company_id")
  @@schema("public")
}

/// Registro de cada consulta a la API externa, incluidos los intentos fallidos
model external_api_access_logs {
  id                     BigInt   @id @default(autoincrement())
  external_api_client_id String?  @db.Uuid
  /// client_id tal cual llego en el header, aunque no exista (detecta tanteo de credenciales)
  attempted_client_id    String?
  /// Nombre logico del recurso, estable aunque cambie la URL
  endpoint               String
  method                 String   @default("GET")
  path                   String
  query_params           Json?
  status_code            Int
  ip_address             String?
  user_agent             String?
  response_time_ms       Int?
  error_message          String?
  created_at             DateTime @default(now()) @db.Timestamptz(6)

  external_api_client external_api_clients? @relation(fields: [external_api_client_id], references: [id], onDelete: SetNull)

  @@index([external_api_client_id, created_at(sort: Desc)], map: "idx_external_api_access_logs_client_date")
  @@index([created_at], map: "idx_external_api_access_logs_created_at")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// Better Auth (P4). Las cuatro tablas del nucleo viven en la misma base que el
// resto del dominio: por eso el alta de un usuario puede ir en una transaccion
// junto con su `profile`, y ya no existe la "credencial huerfana" que dejaba el
// Auth externo cuando la base fallaba despues de crear la credencial.
//
// Nombres de campo en camelCase a proposito: son los que espera el adaptador de
// Prisma de Better Auth. Las columnas si van en snake_case (`@map`), como el
// resto del esquema. Las tablas llevan prefijo `auth_` para que se lean como lo
// que son: el almacen de la libreria, no modelos del dominio.
//
// Los ids son uuid (los genera `advanced.database.generateId` en
// `shared/lib/auth.ts`, no `@default`): `user.id` es el valor que viaja como
// `profile.credential_id` y como `app.user_id` de los triggers de auditoria, y
// `withActor()` exige uuid.
// ─────────────────────────────────────────────────────────────────────────────

/// Credencial de acceso. NO es el perfil del dominio: ese es `profile`, y se
/// vincula por `profile.credential_id = user.id` (ver `shared/lib/actor.ts`).
///
/// A PROPOSITO no hay FK de `profile.credential_id` a `user.id`. El motivo NO es
/// el borrado (con `ON DELETE RESTRICT` no habria problema), sino que cualquier
/// referencial que elijamos deja un caso malo:
///
/// - `SET NULL` / `CASCADE`: `profile.credential_id` es el destino de 12 FKs de
///   otras tablas (`user_roles`, `user_permissions`, `dailyreportrows_history`,
///   `preparte`, `kpi_revisions`, ...). Ponerlo en NULL o borrar la fila arrastra
///   o viola esas 12.
/// - `RESTRICT`: el plugin `anonymous()` de Better Auth borra usuarios anonimos
///   por su cuenta (hoy esta desactivado con `disableDeleteAnonymousUser`, pero
///   seria un acoplamiento a esa opcion), y el rollback del alta necesita poder
///   borrar la credencial recien creada.
///
/// La consistencia la da el alta transaccional de `registerUserWithRole()`:
/// credencial y `profile` se crean juntos o no se crea ninguno. Lo que la FK
/// aportaria —que no exista un `credential_id` colgado— lo garantiza esa
/// transaccion, que es el unico camino de alta del sistema.
model user {
  id                  String    @id @db.Uuid
  name                String
  email               String    @unique
  emailVerified       Boolean   @default(false) @map("email_verified")
  image               String?
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  /// Plugin `anonymous()`: el operario que entra por el QR de mantenimiento.
  isAnonymous         Boolean   @default(false) @map("is_anonymous")
  /// El alta con contrasena temporal pide cambiarla en el primer ingreso.
  needsPasswordChange Boolean   @default(false) @map("needs_password_change")
  /// Baja de usuario (tab Empresa -> Usuarios). Lo chequea el hook
  /// `session.create.before`: un usuario baneado no llega a tener sesion.
  banned              Boolean   @default(false)
  banReason           String?   @map("ban_reason")
  banExpires          DateTime? @map("ban_expires") @db.Timestamptz(6)

  accounts account[]
  sessions session[]

  @@map("auth_user")
  @@schema("public")
}

/// Sesion activa. `company` y `employeeId` son los CLAIMS del perimetro
/// multi-empresa: viven aca (y no en el usuario) porque se resuelven contra la
/// base en cada alta de sesion. Son `input: false` en la config de Better Auth
/// —ningun endpoint los acepta del cliente— y solo los escribe
/// `shared/lib/session-claims.ts`, siempre despues de validar la pertenencia.
model session {
  id         String   @id @db.Uuid
  token      String   @unique
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  /// Empresa activa de la sesion. Equivale al viejo `app_metadata.company`.
  company    String?  @db.Uuid
  /// Legajo del operario del QR. Equivale al viejo `app_metadata.employee_id`.
  employeeId String?  @map("employee_id") @db.Uuid

  user user @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_auth_session_user_id")
  @@map("auth_session")
  @@schema("public")
}

/// Credenciales por proveedor: `providerId = 'credential'` guarda el hash de la
/// contrasena; los demas son OAuth (Google).
model account {
  id                    String    @id @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user user @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_auth_account_user_id")
  @@index([providerId, accountId], map: "idx_auth_account_provider")
  @@map("auth_account")
  @@schema("public")
}

/// Tokens de un solo uso: verificacion de email y recuperacion de contrasena.
model verification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([identifier], map: "idx_auth_verification_identifier")
  @@map("auth_verification")
  @@schema("public")
}

